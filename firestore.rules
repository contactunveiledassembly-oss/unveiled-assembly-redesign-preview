rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // Firestore rules can't run a `where` query to answer "does this
    // person have a registration for this class" — only `exists`/`get`
    // on a KNOWN document path. So enrollment is mirrored into its own
    // classEnrollments/{teachingId}_{uid} doc with a deterministic ID
    // (write it alongside the registration itself — see the
    // createTeachingRegistration() comment in app.js marking where).
    // A non-cancelled mirror doc IS enrollment; nothing else grants it.
    function isEnrolledInClass(teachingId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/classEnrollments/$(teachingId + '_' + request.auth.uid)) &&
        get(/databases/$(database)/documents/classEnrollments/$(teachingId + '_' + request.auth.uid)).data.status != 'cancelled';
    }

    // Member/admin profiles. A user can only ever create/read their own
    // profile (or an admin can read/manage any profile). Nobody can grant
    // themselves the 'admin' role except the one hardcoded ministry email,
    // and only at account-creation time.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId &&
        (request.resource.data.role == 'member' ||
         (request.resource.data.role == 'admin' &&
          request.auth.token.email == 'contactunveiledassembly@gmail.com'));
      allow update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == userId &&
         request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // A slot doc represents current occupancy at one exact date+time —
    // deliberately no name/email/phone/reason, just enough to compute
    // public availability (see bookedIntervalsForDate() in app.js), so a
    // guest visitor can read it directly instead of the private `bookings`
    // collection (which they're correctly forbidden from querying below).
    // `count` tracks how many of `capacity` occupants currently hold this
    // exact time; the client deletes the doc once count would reach 0
    // rather than leaving a stale 0-count doc around. Field types/ranges
    // are validated here so a visitor can't write a malformed doc that
    // would corrupt everyone else's availability calculation.
    function validSlotFields(d) {
      return d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        d.sessionType is string && d.sessionType.size() > 0 && d.sessionType.size() < 60 &&
        d.durationMinutes is number && d.durationMinutes > 0 && d.durationMinutes <= 480 &&
        d.bufferBeforeMin is number && d.bufferBeforeMin >= 0 && d.bufferBeforeMin <= 480 &&
        d.bufferAfterMin is number && d.bufferAfterMin >= 0 && d.bufferAfterMin <= 480 &&
        d.capacity is int && d.capacity > 0 && d.capacity <= 20 &&
        d.count is int && d.count > 0 && d.count <= d.capacity &&
        (!('uid' in d) || d.uid == null || d.uid is string);
    }
    match /slots/{slotId} {
      allow read: if true;
      // A fresh slot always starts at count 1 (the first occupant) — this
      // is what stops a visitor from creating an arbitrary/malformed doc,
      // or one that claims to already be at some other occupancy.
      allow create: if request.resource.data.keys().hasOnly(
                        ['date','time','sessionType','durationMinutes','bufferBeforeMin','bufferAfterMin','capacity','count','uid','updatedAt']) &&
                      validSlotFields(request.resource.data) && request.resource.data.count == 1;
      // Taking one more of a multi-capacity slot only ever increments
      // count by exactly 1 and can't change what the slot IS (date/time/
      // session/capacity/duration/buffers) — any visitor may do this,
      // since it only ever fills an already-open seat, never removes
      // someone else's. Freeing a shared seat back up (decrementing) is
      // admin-only: with one `uid` per doc there's no way to prove which
      // of several occupants is releasing their own seat, so rather than
      // let any visitor decrement (and effectively bump a stranger off a
      // shared slot), that case routes through the admin tools. The
      // common capacity-1 case doesn't need this at all — freeing it is
      // always a full delete, handled below.
      allow update: if isAdmin() ||
        (request.resource.data.keys().hasOnly(
            ['date','time','sessionType','durationMinutes','bufferBeforeMin','bufferAfterMin','capacity','count','uid','updatedAt']) &&
          validSlotFields(request.resource.data) &&
          request.resource.data.date == resource.data.date &&
          request.resource.data.time == resource.data.time &&
          request.resource.data.sessionType == resource.data.sessionType &&
          request.resource.data.capacity == resource.data.capacity &&
          request.resource.data.durationMinutes == resource.data.durationMinutes &&
          request.resource.data.bufferBeforeMin == resource.data.bufferBeforeMin &&
          request.resource.data.bufferAfterMin == resource.data.bufferAfterMin &&
          request.resource.data.count == resource.data.count + 1);
      // Deleting fully frees the time back up, so it's only allowed once
      // count is already down to the last occupant (1) — a stranger can
      // never delete a slot out from under a still-shared multi-capacity
      // booking, and the uid check still means only the person who took
      // the LAST remaining seat (or the admin) can free it.
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid && resource.data.count <= 1);
    }

    // Dates the ministry has marked unavailable (holidays, travel, etc).
    // Public read so the booking form can grey them out; only an admin
    // can add/remove one.
    match /blockouts/{date} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin-controlled scheduling configuration (Phase 3-6). Public read
    // (the booking page must be able to compute availability before anyone
    // signs in); only an admin can change what services/hours/policies exist.
    match /schedulingSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /sessionTypes/{sessionTypeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /availabilityRules/{ruleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blockoutRanges/{rangeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /availabilityOverrides/{date} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Night of Prayer — a single admin-configured doc. Public read so the
    // homepage can show real details once a date exists; empty/missing is
    // the correct "not scheduled yet" state (the client shows a neutral
    // message instead of ever inventing a date — see renderNightOfPrayer()
    // in app.js). Only an admin can set it, same pattern as scheduling.
    match /nightOfPrayer/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Prayer requests are always private (never publicly readable, per
    // ministry policy — not just "admin-only by default" like bookings).
    // Anonymous submission is allowed (name/email/phone are optional on
    // the form) — an authorized reader still sees the doc either way,
    // there's just no name attached when the submitter left it blank.
    // Folded into isAdmin() for now rather than a separate Prayer Team
    // role — see PROJECT-CONTEXT.md's Roles and Permissions section for
    // why that split isn't implemented yet.
    match /prayerRequests/{requestId} {
      allow create: if request.resource.data.keys().hasAll(['message','status','createdAt']) &&
                      request.resource.data.message is string &&
                      request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 4000 &&
                      request.resource.data.status == 'new';
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    // Testimonies and class reviews share one visibility model: a new
    // submission always starts 'pending' and is never publicly readable
    // until an admin (Testimony Reviewer, once that role exists — see
    // Roles section) sets it to 'published'. The submitter's chosen
    // display preference (public-with-name / public-anonymous / private)
    // lives in `visibility` and is honored by the client's rendering, not
    // by these rules — this rule only controls WHETHER a document is
    // readable at all, not how a name is shown once it is.
    match /testimonials/{itemId} {
      allow create: if request.resource.data.keys().hasAll(['message','visibility','status','createdAt']) &&
                      request.resource.data.message is string &&
                      request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 6000 &&
                      request.resource.data.status == 'pending';
      allow read: if isAdmin() || resource.data.status == 'published';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /classReviews/{itemId} {
      allow create: if request.resource.data.keys().hasAll(['message','visibility','status','createdAt']) &&
                      request.resource.data.message is string &&
                      request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 6000 &&
                      request.resource.data.status == 'pending';
      allow read: if isAdmin() || resource.data.status == 'published';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    // Minimal audit trail for administrative actions (booking cancel/
    // decline, prayer/testimony status changes, and similar — see
    // logAdminAction() in app.js for exactly which actions are covered
    // today; PROJECT-CONTEXT.md tracks what still needs to be added).
    // Write-only from the client — nobody can edit or delete an entry
    // once made, including the admin who made it, which is the whole
    // point of an audit trail. Only an admin can read it back.
    match /auditLog/{entryId} {
      allow create: if isAdmin() &&
                      request.resource.data.keys().hasAll(['action','actorUid','actorEmail','at']) &&
                      request.resource.data.actorUid == request.auth.uid;
      allow read: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }
    // Public-facing Terms and Conditions / No Refund Policy text shown at
    // checkout. Public read so the booking form can display and require
    // agreement to them; only an admin can edit the wording.
    match /bookingPolicies/{policyId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Temporary (10-minute) holds while someone is mid-checkout. Public
    // create/read (any visitor can hold an open slot and see what's held),
    // but a plain `allow delete: if true` used to let ANY visitor delete
    // ANY other visitor's still-active hold to snipe their time — holds
    // are intentionally anonymous (no per-visitor identity to check
    // against), so the only way to stop that without a paid Cloud
    // Function is to make a hold undeletable by anyone but the admin
    // until the server clock (not the client-supplied `expiresAt`) says
    // its 10 minutes are actually up. A visitor who changes their mind
    // and picks a different time isn't blocked by this — their old hold
    // just expires on its own shortly after, the same as it already did
    // for the no-action case, and `activeHoldsForDate()` already ignores
    // holds past `expiresAt` either way. The real double-booking guard is
    // the `slots` transaction at booking time, not this hold — this is
    // best-effort UX to reduce (not eliminate) two visitors racing for
    // the same time, so this tradeoff costs nothing real.
    match /bookingHolds/{holdId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['date','time','sessionTypeId','expiresAt','createdAt']) &&
        request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.time is string && request.resource.data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        holdId == request.resource.data.date + '_' + request.resource.data.time + '_hold' &&
        request.resource.data.expiresAt is number;
      allow delete: if isAdmin() || request.time > resource.data.createdAt + duration.value(10, 'm');
      allow update: if false;
    }

    // Booking requests hold personal data (name/email), so only the admin
    // or the booker themself (if signed in) can read them back. Anyone can
    // create one (guest booking is allowed), but a non-admin's request must
    // start 'pending' — only an admin can create one already 'confirmed'
    // (used by the manual "Add An Appointment" panel in Ministry View).
    // A signed-in booker may update their OWN booking, but only to flip its
    // status to 'cancelled' — no other field, and not to any other status.
    // Admin can update anything (confirm/decline/reschedule).
    match /bookings/{bookingId} {
      allow create: if request.resource.data.keys().hasAll(
                        ['name','email','sessionType','date','time','status']) &&
                      (request.resource.data.status == 'pending' || isAdmin());
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
         request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Teaching Manager (recurring paid classes).
    // ---------------------------------------------------------------

    // Public teaching info only — title, description, date/time, price,
    // artwork URLs, status, etc. Drafts are hidden from everyone except
    // an admin; anything else (published/registration-open/sold-out/
    // completed/cancelled) is publicly readable. Only an admin can write.
    match /teachings/{teachingId} {
      allow read: if resource.data.status != 'draft' || isAdmin();
      allow write: if isAdmin();
    }

    // Private Zoom URL/meeting ID/passcode for a teaching. Deliberately a
    // SEPARATE collection from the public `teachings` doc above (not just
    // a field on it) so a public read of a teaching can never expose this
    // — Firestore rules can't redact individual fields of a readable doc,
    // only whole documents, so the private data has to live in its own
    // document with its own stricter rule. Now readable by an enrolled,
    // non-cancelled registrant for that exact class too (fulfills the
    // "expand later" note this rule used to carry) — never by anyone
    // browsing the public class page without registering.
    match /teachingZoomInfo/{teachingId} {
      allow read: if isAdmin() || isEnrolledInClass(teachingId);
      allow write: if isAdmin();
    }

    // Mirrors teachingRegistrations into a deterministic-ID doc purely so
    // isEnrolledInClass() above can check it — see that function's
    // comment. Never written by the client directly; only the same
    // server-side/trusted write path that creates the registration
    // itself should write this (kept admin-only here, not "any signed-in
    // user for their own uid", so a member can't grant themselves access
    // to a class they never actually paid for/registered to).
    match /classEnrollments/{enrollmentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.memberUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // Notes, study guides, and resources published into a class's
    // classroom. Public metadata about WHICH classes have content is not
    // exposed — read requires either being the admin or being enrolled
    // in that exact class, same access rule as the Zoom info above. A
    // resource's `releaseAt`/`releaseHours` timing is enforced here too,
    // not just in the UI — an enrolled member still can't read a resource
    // before its computed release time.
    match /classroomContent/{teachingId}/items/{itemId} {
      allow read: if isAdmin() || (isEnrolledInClass(teachingId) &&
        (resource.data.releaseMode == 'immediate' ||
         resource.data.releaseMode == null ||
         (resource.data.releaseMode == 'fixed-datetime' && request.time >= resource.data.releaseAt) ||
         (resource.data.releaseMode == 'hours-before-class' && request.time >= resource.data.releaseAt)));
      allow write: if isAdmin();
    }

    // Private, per-class questions. A member can create one only for a
    // class they're enrolled in, and only ever read/see their OWN
    // questions for that class — never another student's. The admin can
    // read/answer/archive any question for any class.
    match /classQuestions/{questionId} {
      allow create: if isEnrolledInClass(request.resource.data.teachingId) &&
        request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Announcements for a class's classroom. Only enrolled members (or
    // the admin) can read them, and only once published (draft/scheduled
    // announcements stay admin-only until their publishAt has passed).
    match /classAnnouncements/{announcementId} {
      allow read: if isAdmin() || (isEnrolledInClass(resource.data.teachingId) &&
        resource.data.status == 'published' && request.time >= resource.data.publishAt);
      allow write: if isAdmin();
    }

    // Waitlist entries hold personal data, so same pattern as bookings/
    // teachingRegistrations: the admin or the entry's own person (once
    // they're signed in) can read it back. Anyone (including a guest) can
    // create an entry; only the admin can change its status (send an
    // offer, remove someone) — a member can never edit their own position
    // or self-approve an offer.
    match /classWaitlist/{entryId} {
      allow create: if request.resource.data.keys().hasAll(['teachingId','name','email','status']) &&
                      request.resource.data.status == 'waiting';
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Learning paths are just a public, ordered grouping of already-public
    // classes — public read, admin-only write, no personal data involved.
    match /learningPaths/{pathId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // In-portal member notifications (registration confirmed, new notes,
    // question answered, waitlist offer, etc). A member can only ever
    // read/mark-read their OWN notifications; only the admin (or the
    // trusted server-side path that creates them alongside the event
    // they describe) can create one.
    match /memberNotifications/{notificationId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // Sitewide Teaching page settings (featured teaching, section
    // visibility toggles, etc). Public read so the page can render;
    // only an admin can change it.
    match /teachingPageSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Owner Media Library — images uploaded from Owner → Media, reused
    // across Teaching/Scripture images. Same pattern as teachingPageSettings:
    // public read (the images themselves are already public once used on a
    // page), admin-only write.
    match /mediaLibrary/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Teaching registrations hold personal data, so the same pattern as
    // `bookings` above: only the admin or the registrant themself (if
    // signed in) can read one back; anyone can create one (guest
    // registration allowed) but it must start 'pending_payment' unless
    // an admin is creating it directly; a signed-in registrant may only
    // ever update their own registration to cancel it.
    match /teachingRegistrations/{regId} {
      allow create: if request.resource.data.keys().hasAll(
                        ['teachingId','firstName','lastName','email','status']) &&
                      (request.resource.data.status == 'pending_payment' || isAdmin());
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
         request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }
  }
}
